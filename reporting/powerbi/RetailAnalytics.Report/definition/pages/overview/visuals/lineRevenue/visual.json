{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "lineRevenue",
  "position": {
    "x": 20,
    "y": 150,
    "z": 4,
    "height": 330,
    "width": 760,
    "tabOrder": 4
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "year_month"
                }
              },
              "queryRef": "dim_date.year_month",
              "nativeQueryRef": "year_month",
              "active": true,
              "displayName": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_order_items"
                    }
                  },
                  "Property": "Daily Revenue"
                }
              },
              "queryRef": "fact_order_items.Daily Revenue",
              "nativeQueryRef": "Daily Revenue"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_order_items"
                    }
                  },
                  "Property": "Daily Margin"
                }
              },
              "queryRef": "fact_order_items.Daily Margin",
              "nativeQueryRef": "Daily Margin"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "dim_date"
                  }
                },
                "Property": "year_month"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Average daily revenue and margin per month'"
                }
              }
            }
          }
        }
      ]
    }
  }
}