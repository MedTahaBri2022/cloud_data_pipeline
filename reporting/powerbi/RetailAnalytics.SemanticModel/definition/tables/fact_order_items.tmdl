		lineageTag: 493d56bb-cb60-5177-959d-4c00e39e2ea0
		summarizeBy: sum
		sourceColumn: quantity

	column unit_price
		dataType: decimal
		formatString: #,##0.00
		lineageTag: 03013906-05f8-53c4-93a4-7b87e6aacf67
		summarizeBy: none
		sourceColumn: unit_price

	column line_revenue
		dataType: decimal
		isHidden
		formatString: #,##0.00
		lineageTag: 930372de-c84a-5d22-a602-ccad06cef39b
		summarizeBy: sum
		sourceColumn: revenue

	column line_cost
		dataType: decimal
		isHidden
		formatString: #,##0.00
		lineageTag: 186d120e-f254-5761-8c40-703c33461b25
		summarizeBy: sum
		sourceColumn: cost

	column line_margin
		dataType: decimal
		isHidden
		formatString: #,##0.00
		lineageTag: 71d7f1ef-7061-5cf4-9967-07c32588474f
		summarizeBy: sum
		sourceColumn: margin

	partition fact_order_items = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_order_items.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"order_id", type text}, {"product_key", Int64.Type}, {"customer_key", Int64.Type}, {"date_key", Int64.Type}, {"status", type text}, {"channel", type text}, {"quantity", Int64.Type}, {"unit_price", Currency.Type}, {"revenue", Currency.Type}, {"cost", Currency.Type}, {"margin", Currency.Type}}, "en-US")
				in
				    Typed

