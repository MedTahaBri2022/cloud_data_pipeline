		sourceColumn: product_key

	column product_id
		dataType: string
		lineageTag: a226833e-a1fe-56f4-9e07-d7fc1bbe924a
		summarizeBy: none
		sourceColumn: product_id

	column name
		dataType: string
		lineageTag: 236fbfbc-73fa-52ba-994e-135fba300fb5
		summarizeBy: none
		sourceColumn: name

	column category
		dataType: string
		lineageTag: 9b88e023-f55a-5b15-a6b7-7ffe3e61bfc5
		summarizeBy: none
		sourceColumn: category

	column unit_cost
		dataType: decimal
		formatString: #,##0.00
		lineageTag: 73536440-fd0d-557b-a5d1-4686de7f7298
